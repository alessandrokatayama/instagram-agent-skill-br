  "structures": [
    {
      "id": "nao-e-so",
      "regex": "(?i)\\bnão (?:é|se trata de) (?:só|apenas|somente) [^.!?\\n]{2,60}[,.;] (?:é|se trata)\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a única coisa que você quer dizer. Apague a metade da preparação."
    },
    {
      "id": "nao-so-mas",
      "regex": "(?i)\\bnão (?:só|somente|apenas)\\b[^.!?\\n]{2,80}\\bmas (?:também|sim)\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Quebre em duas frases, ou corte a metade mais fraca."
    },
    {
      "id": "nao-se-trata",
      "regex": "(?i)\\b(?:isso |não )?(?:não é|não se trata) (?:sobre|de) [^.!?\\n]{2,60}[.!,;]\\s*(?:é|se trata|e sim)\\b",
      "name": "\"Não se trata de X. Se trata de Y.\"",
      "fix": "Comece pelo Y. A inversão é o que entrega."
    },
    {
      "id": "pergunta-palco",
      "regex": "(?im)^\\s*(?:o resultado|a melhor parte|o detalhe|o problema|a pegadinha|o segredo|e o melhor)\\?\\s*$",
      "name": "Linha de pergunta retórica de uma palavra",
      "fix": "Responda na mesma frase em vez de montar um suspense."
    },
    {
      "id": "o-que-aprendi",
      "regex": "(?i)\\b(?:aqui está|eis|olha) o que (?:eu )?aprendi\\b|\\bo que eu aprendi:\\s*$",
      "name": "\"Aqui está o que eu aprendi\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "trinca",
      "regex": "(?i)\\b[\\wÀ-ÿ]+, [\\wÀ-ÿ]+ e [\\wÀ-ÿ]+\\.",
      "name": "Regra de três",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão de máquina."
    },
    {
      "id": "foguete",
      "regex": "[🚀🔥💡✨🎯]",
      "name": "Emoji de foguete, fogo, lâmpada, brilho ou alvo",
      "fix": "No máximo um emoji, e não um desses cinco."
    },
    {
      "id": "muro-hashtag",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Muro de hashtags (6 ou mais)",
      "fix": "Até cinco. O Instagram limita a cinco por post desde dezembro de 2025."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|inteligência artificial|modelo de linguagem|assistente virtual)\\b",
      "name": "Autorreferência de modelo",
      "fix": "Apague a frase."
    },
    {
      "id": "fecho-redacao",
      "regex": "(?im)^\\s*(?:em resumo|resumindo|em suma|em conclusão|concluindo|por fim)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "isca-engajamento",
      "regex": "(?im)\\b(?:concorda\\?|concordam\\?|o que (?:vocês )?acham\\?|quem mais\\b|tô errado\\?|estou errad[oa]\\?|faz sentido\\?)\\s*$",
      "name": "Isca de engajamento automática",
      "fix": "Faça uma pergunta que só você faria, sobre a coisa específica acima dela."
    },
    {
      "id": "para-de-rolar",
      "regex": "(?im)^\\s*(?:para|pare|espera,? não) (?:de )?(?:rolar|passar|pula|pular)\\b|^\\s*não (?:passa|pula|role)\\b",
      "name": "Abertura \"para de rolar\"",
      "fix": "O que para a rolagem tem que ser a afirmação. Pedir atenção mostra que você ainda não conquistou."
    },
    {
      "id": "preambulo-video",
      "regex": "(?i)\\b(?:n(?:ess|est)e (?:vídeo|video|reel|post)|no (?:vídeo|video|reel) de hoje|hoje eu vou (?:te |vos )?(?:mostrar|ensinar|falar)|vou (?:te )?(?:mostrar|ensinar) como)\\b",
      "name": "Preâmbulo de vídeo (\"nesse vídeo eu vou te mostrar\")",
      "fix": "Apague e comece pelo resultado. Os dois primeiros segundos decidem o reel inteiro."
    },
    {
      "id": "lista-emoji",
      "regex": "(?m)^\\s*[🌀-🫿✅➡⬅✔✨▶⭐]\\s*\\S",
